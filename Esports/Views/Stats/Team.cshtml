@model Esports.ViewModels.TeamStatsViewModel
@{
    ViewData["Title"] = Model.Team.Name + " - Team Analytics";
}

<div class="card shadow-sm border-0 mb-4 bg-dark text-white p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <img src="@(!string.IsNullOrEmpty(Model.Team.LogoUrl) ? Model.Team.LogoUrl : "/images/default-team-logo.svg")" 
                 alt="@Model.Team.Name logo" 
                 class="rounded me-3 border" 
                 style="width:64px;height:64px;object-fit:cover;" 
                 onerror="this.onerror=null;this.src='/images/default-team-logo.svg';" />
            <div>
                <h2 class="fw-bold mb-0">@Model.Team.Name</h2>
                <p class="text-white-50 mb-0">Game: <span class="badge bg-primary">@Model.Team.Game?.Name</span> | Founded: @Model.Team.CreatedAt.ToString("MMM yyyy")</p>
            </div>
        </div>
        <div class="text-end mt-3 mt-md-0">
            <h6 class="text-white-50 text-uppercase mb-0">Total Prize Money</h6>
            <h2 class="fw-bold text-success mb-0">$@Model.TotalPrizeMoney.ToString("N2")</h2>
        </div>
    </div>
</div>

<!-- Team Performance KPI Cards -->
<div class="row g-3 mb-4 text-center">
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 p-3 bg-white">
            <h6 class="text-muted text-uppercase small mb-1">Matches Played</h6>
            <h3 class="fw-bold mb-0">@Model.TotalMatches</h3>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 p-3 bg-white">
            <h6 class="text-muted text-uppercase small mb-1">Win Rate</h6>
            <h3 class="fw-bold text-success mb-0">@Model.WinRate%</h3>
            <small class="text-muted">@Model.TotalWins W - @Model.TotalLosses L - @Model.TotalDraws D</small>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 p-3 bg-white">
            <h6 class="text-muted text-uppercase small mb-1">Tournaments</h6>
            <h3 class="fw-bold text-warning mb-0">@Model.TournamentsCount</h3>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 p-3 bg-white">
            <h6 class="text-muted text-uppercase small mb-1">Roster Size</h6>
            <h3 class="fw-bold text-primary mb-0">@Model.PlayerSummaries.Count</h3>
        </div>
    </div>
</div>

<!-- Roster Performance Aggregate Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill text-primary me-2"></i>Roster Performance Breakdown</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Player</th>
                        <th>In-Game Role</th>
                        <th>Logged Matches</th>
                        <th>Kills</th>
                        <th>Deaths</th>
                        <th>Assists</th>
                        <th>KDA Ratio</th>
                        <th class="text-end">Full Profile</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.PlayerSummaries.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No player performance data available for this team.</td>
                        </tr>
                    }
                    @foreach (var p in Model.PlayerSummaries)
                    {
                        <tr>
                            <td class="fw-bold">@p.FullName</td>
                            <td><span class="badge bg-dark">@p.RoleName</span></td>
                            <td>@p.MatchesCount</td>
                            <td class="text-success fw-bold">@p.Kills</td>
                            <td class="text-danger fw-bold">@p.Deaths</td>
                            <td class="text-info fw-bold">@p.Assists</td>
                            <td><span class="badge bg-primary fs-6">@p.KdaRatio.ToString("F2")</span></td>
                            <td class="text-end">
                                <a asp-controller="Stats" asp-action="Player" asp-route-id="@p.PlayerId" class="btn btn-sm btn-outline-secondary">View Profile</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Recent Matches & Tournaments -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-journal-text text-success me-2"></i>Recent Team Matches</h5>
                <a asp-controller="Record" asp-action="Index" asp-route-teamId="@Model.Team.Id" class="btn btn-sm btn-outline-success">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Opponent</th>
                                <th>Result</th>
                                <th>Team KDA</th>
                                <th>Top Performer / MVP</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentMatchGroups.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No recent match records.</td>
                                </tr>
                            }
                            @foreach (var match in Model.RecentMatchGroups)
                            {
                                var isWin = string.Equals(match.Result, "Win", StringComparison.OrdinalIgnoreCase);
                                var mvp = match.Players.FirstOrDefault(p => p.IsMvp) ?? match.Players.OrderByDescending(p => p.Score).FirstOrDefault();
                                <tr>
                                    <td class="text-nowrap fw-semibold">@match.MatchDate.ToString("yyyy-MM-dd")</td>
                                    <td class="fw-bold">
                                        <span>vs @match.Opponent</span>
                                    </td>
                                    <td>
                                        <span class="badge @(isWin ? "bg-success" : "bg-danger")">@match.Result</span>
                                    </td>
                                    <td class="text-nowrap">
                                        <span class="fw-semibold text-dark">@match.TotalKills</span> /
                                        <span class="text-danger">@match.TotalDeaths</span> /
                                        <span class="text-info">@match.TotalAssists</span>
                                    </td>
                                    <td class="text-nowrap">
                                        @if (mvp != null)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>@mvp.PlayerName</span>
                                            <small class="text-muted ms-1">(@mvp.RoleName)</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Record" asp-action="Index" asp-route-teamId="@Model.Team.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-trophy-fill text-warning me-2"></i>Tournament History</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tournament</th>
                                <th>Placement</th>
                                <th class="text-end">Prize Pool</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Tournaments.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-3 text-muted">No tournament records.</td>
                                </tr>
                            }
                            @foreach (var t in Model.Tournaments)
                            {
                                <tr>
                                    <td class="fw-bold">@t.Name</td>
                                    <td><span class="badge bg-secondary">@(t.Placement ?? "Completed")</span></td>
                                    <td class="text-end text-success fw-bold">$@t.PrizePoolWon.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Team" asp-action="Details" asp-route-id="@Model.Team.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Team Overview</a>
</div>
