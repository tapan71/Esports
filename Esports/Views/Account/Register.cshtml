@model Esports.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2 text-warning"></i>Create New Account</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Alex Johnson" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+1 (555) 000-0000" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="Player">Player - Join teams and compete in matches</option>
                            <option value="Coach">Coach - Manage active rosters and train teams</option>
                            <option value="Owner">Owner - Form teams, manage staff and rosters</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProfilePhotoFile" class="form-label fw-semibold">
                            <i class="bi bi-image me-1"></i>Profile Photo / Logo <span class="text-muted fw-normal small">(Optional)</span>
                        </label>
                        <input asp-for="ProfilePhotoFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="ProfilePhotoFile" class="text-danger small"></span>
                        <div class="form-text">Choose an image from your device (PNG, JPG, SVG, WebP).</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-2">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i>Create Account
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <span class="text-muted">Already have an account?</span>
                        <a asp-action="Login" class="fw-semibold text-decoration-none ms-1">Log in here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}