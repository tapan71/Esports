@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="card-body">
                <div class="display-3 text-danger mb-3">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3 class="card-title fw-bold text-dark">Access Denied</h3>
                <p class="text-muted mt-2">
                    You do not have permission to view or access this resource.
                </p>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="alert alert-light border my-3 py-2 text-start small">
                        <div><strong>Signed in as:</strong> @User.Identity.Name</div>
                        <div>
                            <strong>Active Role:</strong>
                            <span class="badge bg-secondary">
                                @(User.IsInRole("Owner") ? "Owner" : User.IsInRole("Coach") ? "Coach" : "Player")
                            </span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <a asp-controller="Account" asp-action="MyDashboard" class="btn btn-primary">
                            <i class="bi bi-speedometer2 me-1"></i> Go to My Dashboard
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-box-arrow-right me-1"></i> Switch Account
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="mt-4">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Go to Login
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>