@model Esports.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile - " + Model.FullName;
    var avatarSrc = !string.IsNullOrEmpty(Model.CurrentProfilePhotoUrl) 
        ? Model.CurrentProfilePhotoUrl 
        : "/images/default-user-avatar.svg";
}

<div class="row g-4">
    <!-- Left Column: User Profile Overview Card -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body text-center p-4">
                <div class="position-relative d-inline-block mb-3">
                    <img src="@avatarSrc" 
                         alt="@Model.FullName" 
                         class="rounded-circle border shadow-sm" 
                         style="width:120px;height:120px;object-fit:cover;" 
                         onerror="this.onerror=null;this.src='/images/default-user-avatar.svg';" />
                    <span class="position-absolute bottom-0 end-0 badge rounded-pill @(Model.Role == "Owner" ? "bg-warning text-dark" : Model.Role == "Coach" ? "bg-success" : "bg-primary") px-2 py-1">
                        @Model.Role
                    </span>
                </div>
                
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-3">@Model.Email</p>

                <div class="d-flex justify-content-center gap-2 mb-3">
                    @if (Model.Role == "Owner")
                    {
                        <a asp-controller="Dashboard" asp-action="Owner" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-speedometer2 me-1"></i>Owner Dashboard
                        </a>
                    }
                    else if (Model.Role == "Coach")
                    {
                        <a asp-controller="Dashboard" asp-action="Coach" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-speedometer2 me-1"></i>Coach Dashboard
                        </a>
                    }
                    else if (Model.Role == "Player")
                    {
                        <a asp-controller="Dashboard" asp-action="Player" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-speedometer2 me-1"></i>Player Dashboard
                        </a>
                    }
                </div>

                <hr />

                <div class="text-start small">
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted"><i class="bi bi-telephone me-1"></i>Phone:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not Provided" : Model.PhoneNumber)</span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted"><i class="bi bi-calendar3 me-1"></i>Member Since:</span>
                        <span class="fw-semibold">@Model.MemberSince.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted"><i class="bi bi-shield-check me-1"></i>Account Role:</span>
                        <span class="badge bg-dark">@Model.Role</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Esports Affiliations Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-trophy-fill text-warning me-2"></i>Esports Associations</h6>
            </div>
            <div class="card-body p-3">
                @if (Model.Role == "Owner")
                {
                    if (Model.OwnedTeams.Any())
                    {
                        <h6 class="small text-muted text-uppercase fw-bold mb-2">Owned Teams</h6>
                        <ul class="list-group list-group-flush">
                            @foreach (var team in Model.OwnedTeams)
                            {
                                <li class="list-group-item d-flex align-items-center justify-content-between px-0 py-2">
                                    <div class="d-flex align-items-center">
                                        <img src="@(!string.IsNullOrEmpty(team.LogoUrl) ? team.LogoUrl : "/images/default-team-logo.svg")" 
                                             alt="@team.Name" class="rounded me-2 border" style="width:28px;height:28px;object-fit:cover;"
                                             onerror="this.onerror=null;this.src='/images/default-team-logo.svg';" />
                                        <span class="fw-semibold small">@team.Name</span>
                                    </div>
                                    <a asp-controller="Team" asp-action="Details" asp-route-id="@team.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No teams created yet.</p>
                    }
                }
                else if (Model.Role == "Coach")
                {
                    if (Model.StaffPositions.Any())
                    {
                        <h6 class="small text-muted text-uppercase fw-bold mb-2">Coached Teams</h6>
                        <ul class="list-group list-group-flush">
                            @foreach (var staff in Model.StaffPositions)
                            {
                                <li class="list-group-item d-flex align-items-center justify-content-between px-0 py-2">
                                    <div class="d-flex align-items-center">
                                        <img src="@(!string.IsNullOrEmpty(staff.Team?.LogoUrl) ? staff.Team.LogoUrl : "/images/default-team-logo.svg")" 
                                             alt="@staff.Team?.Name" class="rounded me-2 border" style="width:28px;height:28px;object-fit:cover;"
                                             onerror="this.onerror=null;this.src='/images/default-team-logo.svg';" />
                                        <div>
                                            <span class="fw-semibold small d-block">@staff.Team?.Name</span>
                                            <span class="text-muted" style="font-size:0.75rem;">Since @staff.HiredDate.ToString("MMM yyyy")</span>
                                        </div>
                                    </div>
                                    <a asp-controller="Team" asp-action="Details" asp-route-id="@staff.TeamId" class="btn btn-sm btn-outline-secondary">View</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Not assigned to any team currently.</p>
                    }
                }
                else if (Model.Role == "Player")
                {
                    if (Model.Memberships.Any())
                    {
                        <h6 class="small text-muted text-uppercase fw-bold mb-2">Team Rosters</h6>
                        <ul class="list-group list-group-flush">
                            @foreach (var mem in Model.Memberships)
                            {
                                <li class="list-group-item d-flex align-items-center justify-content-between px-0 py-2">
                                    <div class="d-flex align-items-center">
                                        <img src="@(!string.IsNullOrEmpty(mem.Team?.LogoUrl) ? mem.Team.LogoUrl : "/images/default-team-logo.svg")" 
                                             alt="@mem.Team?.Name" class="rounded me-2 border" style="width:28px;height:28px;object-fit:cover;"
                                             onerror="this.onerror=null;this.src='/images/default-team-logo.svg';" />
                                        <div>
                                            <span class="fw-semibold small d-block">@mem.Team?.Name</span>
                                            <span class="badge bg-dark" style="font-size:0.7rem;">@mem.GameRole?.RoleName</span>
                                            <span class="text-muted" style="font-size:0.75rem;">Since @mem.JoinedDate.ToString("MMM yyyy")</span>
                                        </div>
                                    </div>
                                    <a asp-controller="Team" asp-action="Details" asp-route-id="@mem.TeamId" class="btn btn-sm btn-outline-secondary">View</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No active team memberships.</p>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Edit Profile Form -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Profile Details</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Role" />
                    <input type="hidden" asp-for="CurrentProfilePhotoUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <h6 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-person me-2"></i>Personal Information</h6>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted">Email Address</label>
                        <input type="text" class="form-control bg-light" value="@Model.Email" readonly disabled />
                        <div class="form-text">Email address is your primary login username and cannot be modified.</div>
                    </div>

                    <!-- Profile Avatar Customization -->
                    <div class="card bg-light border-0 p-3 mb-4 mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0"><i class="bi bi-image me-1"></i>Profile Photo / Avatar Logo</h6>
                            @if (Model.CurrentProfilePhotoUrl == "/images/default-user-avatar.svg")
                            {
                                <span class="badge bg-info text-dark">Default Avatar</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Custom Avatar</span>
                            }
                        </div>

                        <div class="mb-3 d-flex align-items-center bg-white p-2 rounded border">
                            <img src="@avatarSrc" alt="Current Avatar" class="rounded-circle border me-3" style="width:48px;height:48px;object-fit:cover;"
                                 onerror="this.onerror=null;this.src='/images/default-user-avatar.svg';" />
                            <div>
                                <span class="small text-muted d-block">Current Profile Picture</span>
                                <span class="small text-truncate d-inline-block text-dark fw-semibold" style="max-width:320px;">@avatarSrc</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProfilePhotoFile" class="form-label fw-semibold">
                                <i class="bi bi-upload me-1"></i>Upload New Avatar from Device
                            </label>
                            <input asp-for="ProfilePhotoFile" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="ProfilePhotoFile" class="text-danger small"></span>
                            <div class="form-text">Choose an image from your local computer to replace your profile picture.</div>
                        </div>

                        <div class="form-check mt-3 pt-2 border-top">
                            <input asp-for="ResetToDefaultAvatar" class="form-check-input" type="checkbox" id="resetAvatarCheckbox" />
                            <label class="form-check-label fw-semibold small text-danger" for="resetAvatarCheckbox">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Default Avatar
                            </label>
                            <div class="form-text small">Check this box to remove your custom avatar and revert to the default gamer avatar.</div>
                        </div>
                    </div>

                    <!-- Security / Change Password Section -->
                    <h6 class="fw-bold mb-3 border-bottom pb-2 mt-4"><i class="bi bi-shield-lock me-2"></i>Change Password (Optional)</h6>
                    <p class="text-muted small">Leave password fields blank if you do not wish to change your current password.</p>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <input asp-for="CurrentPassword" class="form-control" placeholder="Enter current password if changing" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                            <input asp-for="NewPassword" class="form-control" placeholder="New password (min 6 characters)" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Confirm new password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i>Save Profile Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
