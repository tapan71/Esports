@model Esports.ViewModels.RecordIndexViewModel
@{
    ViewData["Title"] = "Match Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Match Performance Records</h2>
        <p class="text-muted">Player and Team Scrim/Tournament Performance Logs</p>
    </div>
    @if (Model.CanManage && Model.TeamId.HasValue)
    {
        <a asp-action="Create" asp-route-teamId="@Model.TeamId.Value" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Log Match Record</a>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Player</th>
                        <th>Team</th>
                        <th>Opponent</th>
                        <th>Result</th>
                        <th>Logged By</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Records.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No match performance records found.</td>
                        </tr>
                    }
                    @foreach (var rec in Model.Records)
                    {
                        <tr>
                            <td>@rec.MatchDate.ToString("yyyy-MM-dd")</td>
                            <td class="fw-bold">@rec.Player.FullName</td>
                            <td><span class="badge bg-dark">@rec.Team.Name</span></td>
                            <td>@(rec.Opponent ?? "Practice / Scrim")</td>
                            <td>
                                <span class="badge @(rec.Result == "Win" ? "bg-success" : rec.Result == "Loss" ? "bg-danger" : "bg-warning")">
                                    @rec.Result
                                </span>
                            </td>
                            <td><small class="text-muted">@rec.LoggedByUser?.FullName</small></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@rec.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye me-1"></i>Stats</a>
                                @if (User.IsInRole("Owner") || User.IsInRole("Coach"))
                                {
                                    <a asp-action="Edit" asp-route-id="@rec.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@rec.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this match record?');"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
