@model Esports.ViewModels.TournamentIndexViewModel
@{
    ViewData["Title"] = "Tournaments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Tournaments & Championships</h2>
        <p class="text-muted">Competitive Events, Placements & Prize Pool Allocations</p>
    </div>
    @if (Model.CanManage && Model.TeamId.HasValue)
    {
        <a asp-action="Create" asp-route-teamId="@Model.TeamId.Value" class="btn btn-warning fw-bold text-dark"><i class="bi bi-trophy-fill me-1"></i> Add Tournament</a>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tournament Name</th>
                        <th>Team</th>
                        <th>Dates</th>
                        <th>Placement</th>
                        <th>Prize Pool Won</th>
                        <th>Participants</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Tournaments.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No tournaments recorded yet.</td>
                        </tr>
                    }
                    @foreach (var t in Model.Tournaments)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@t.Name</td>
                            <td><span class="badge bg-dark">@t.Team?.Name</span></td>
                            <td>@t.StartDate.ToString("MMM dd") - @t.EndDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge bg-secondary">@(t.Placement ?? "Completed")</span>
                            </td>
                            <td class="fw-bold text-success">$@t.PrizePoolWon.ToString("N2")</td>
                            <td>@t.Participants.Count players</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye me-1"></i>Prizes</a>
                                @if (User.IsInRole("Owner") || User.IsInRole("Coach"))
                                {
                                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this tournament entry?');"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
