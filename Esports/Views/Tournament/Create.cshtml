@model Esports.ViewModels.TournamentCreateViewModel
@{
    ViewData["Title"] = "Add Tournament - " + Model.TeamName;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-trophy-fill me-2"></i>Add Tournament Event for @Model.TeamName</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="TeamId" />
                    <input type="hidden" asp-for="TeamName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. LCS Summer Split, Worlds 2026, IEM Katowice" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold"></label>
                            <input asp-for="StartDate" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-semibold"></label>
                            <input asp-for="EndDate" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Placement" class="form-label fw-semibold"></label>
                            <input asp-for="Placement" class="form-control" placeholder="e.g. 1st Place, Champions, 3rd Place" />
                            <span asp-validation-for="Placement" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PrizePoolWon" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PrizePoolWon" class="form-control" />
                            </div>
                            <span asp-validation-for="PrizePoolWon" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Participating Roster Players (Prize Pool Split Equally)</label>
                        @if (!Model.AvailablePlayers.Any())
                        {
                            <div class="alert alert-info">No active players on the team roster yet.</div>
                        }
                        else
                        {
                            <div class="card p-3 bg-light border">
                                @foreach (var p in Model.AvailablePlayers)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedPlayerIds" value="@p.Value" id="player_@p.Value" checked />
                                        <label class="form-check-label" for="player_@p.Value">
                                            @p.Text
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Tournament highlights, MVP notes, organizers..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" asp-route-teamId="@Model.TeamId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning fw-bold text-dark"><i class="bi bi-check-lg me-1"></i>Save Tournament</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
