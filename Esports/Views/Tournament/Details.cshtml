@model Esports.ViewModels.TournamentDetailsViewModel
@{
    ViewData["Title"] = Model.Tournament.Name + " - Tournament Details";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <span class="badge bg-warning text-dark mb-2"><i class="bi bi-trophy-fill me-1"></i>@(Model.Tournament.Placement ?? "Tournament Event")</span>
                <h2 class="fw-bold mb-1">@Model.Tournament.Name</h2>
                <p class="text-muted mb-0">
                    Team: <strong>@Model.Tournament.Team?.Name</strong> | Dates: @Model.Tournament.StartDate.ToString("MMM dd, yyyy") to @Model.Tournament.EndDate.ToString("MMM dd, yyyy")
                </p>
            </div>
            <div class="text-end mt-2 mt-md-0">
                <h6 class="text-muted text-uppercase mb-0">Total Prize Pool Won</h6>
                <h2 class="fw-bold text-success mb-0">$@Model.Tournament.PrizePoolWon.ToString("N2")</h2>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Tournament.Notes))
        {
            <div class="alert alert-light border mt-3 mb-0">
                <i class="bi bi-info-circle me-1 text-primary"></i>@Model.Tournament.Notes
            </div>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Participants and Equal Base Shares -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill text-primary me-2"></i>Roster Participant Prize Shares</h5>
                <span class="badge bg-light text-dark">Equal Share Split</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Participant</th>
                                <th>Email</th>
                                <th class="text-end">Base Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Tournament.Participants.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No participants attached to this tournament.</td>
                                </tr>
                            }
                            @foreach (var p in Model.Tournament.Participants)
                            {
                                <tr>
                                    <td class="fw-bold">@p.Player?.FullName</td>
                                    <td class="text-muted">@p.Player?.Email</td>
                                    <td class="text-end text-success fw-bold">$@p.BaseShare.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        @if (Model.Tournament.Participants.Any())
                        {
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="2">Total Base Distributed:</th>
                                    <th class="text-end text-success">$@Model.Tournament.Participants.Sum(p => p.BaseShare).ToString("N2")</th>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Special Performance Rewards & Bonuses -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-award-fill text-warning me-2"></i>Special Award Bonuses</h5>
                @if (Model.CanManage)
                {
                    <a asp-controller="Reward" asp-action="Create" asp-route-tournamentId="@Model.Tournament.Id" class="btn btn-sm btn-outline-warning text-dark"><i class="bi bi-plus me-1"></i>Add Bonus</a>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Player</th>
                                <th>Reward Title</th>
                                <th class="text-end">Bonus</th>
                                @if (Model.CanManage)
                                {
                                    <th class="text-end"></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Tournament.Rewards.Any())
                            {
                                <tr>
                                    <td colspan="@(Model.CanManage ? 4 : 3)" class="text-center py-4 text-muted">No special individual bonus rewards awarded.</td>
                                </tr>
                            }
                            @foreach (var r in Model.Tournament.Rewards)
                            {
                                <tr>
                                    <td class="fw-medium">@r.Player?.FullName</td>
                                    <td><span class="badge bg-warning text-dark">@r.RewardTitle</span></td>
                                    <td class="text-end text-success fw-bold">+$@r.BonusAmount.ToString("N2")</td>
                                    @if (Model.CanManage)
                                    {
                                        <td class="text-end">
                                            <form asp-controller="Reward" asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" onclick="return confirm('Remove bonus?');"><i class="bi bi-x-circle"></i></button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between mt-4">
    <a asp-action="Index" asp-route-teamId="@Model.Tournament.TeamId" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Tournaments</a>
    @if (Model.CanManage)
    {
        <a asp-action="Edit" asp-route-id="@Model.Tournament.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit Tournament</a>
    }
</div>
