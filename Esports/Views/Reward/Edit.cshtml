@model Esports.ViewModels.RewardEditViewModel
@{
    ViewData["Title"] = "Edit Reward";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Special Reward</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-muted">Player: <strong>@Model.PlayerName</strong> | Tournament: <strong>@Model.TournamentName</strong></p>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="TournamentId" />
                    <input type="hidden" asp-for="TournamentName" />
                    <input type="hidden" asp-for="PlayerId" />
                    <input type="hidden" asp-for="PlayerName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="RewardTitle" class="form-label fw-semibold"></label>
                        <input asp-for="RewardTitle" class="form-control" />
                        <span asp-validation-for="RewardTitle" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="BonusAmount" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="BonusAmount" class="form-control" />
                        </div>
                        <span asp-validation-for="BonusAmount" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Tournament" asp-action="Details" asp-route-id="@Model.TournamentId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
