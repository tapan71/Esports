@model Esports.ViewModels.RewardCreateViewModel
@{
    ViewData["Title"] = "Add Reward - " + Model.TournamentName;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-award-fill me-2"></i>Award Special Bonus</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-muted">Tournament: <strong>@Model.TournamentName</strong></p>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="TournamentId" />
                    <input type="hidden" asp-for="TournamentName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="PlayerId" class="form-label fw-semibold"></label>
                        <select asp-for="PlayerId" asp-items="Model.AvailablePlayers" class="form-select">
                            <option value="">-- Select Recipient Player --</option>
                        </select>
                        <span asp-validation-for="PlayerId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RewardTitle" class="form-label fw-semibold"></label>
                        <input asp-for="RewardTitle" class="form-control" placeholder="e.g. MVP of Tournament, Best Mid Laner" />
                        <span asp-validation-for="RewardTitle" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="BonusAmount" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="BonusAmount" class="form-control" />
                        </div>
                        <span asp-validation-for="BonusAmount" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Tournament" asp-action="Details" asp-route-id="@Model.TournamentId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning fw-bold text-dark"><i class="bi bi-star-fill me-1"></i>Grant Reward</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
