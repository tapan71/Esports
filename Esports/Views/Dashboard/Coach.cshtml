@model Esports.ViewModels.CoachDashboardViewModel
@{
    ViewData["Title"] = "Coach Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Coach Dashboard - @Model.CoachName</h2>
        <p class="text-muted">Assigned Team Strategy & Performance Management</p>
    </div>
    @if (Model.AssignedTeam != null)
    {
        <div>
            <a asp-controller="Record" asp-action="Create" asp-route-teamId="@Model.AssignedTeam.Id" class="btn btn-primary me-2"><i class="bi bi-plus-lg me-1"></i> Log Match</a>
            <a asp-controller="Schedule" asp-action="Create" asp-route-teamId="@Model.AssignedTeam.Id" class="btn btn-outline-secondary"><i class="bi bi-calendar-plus me-1"></i> Add Schedule</a>
        </div>
    }
</div>

@if (Model.AssignedTeam == null)
{
    <div class="alert alert-warning shadow-sm">
        <h5 class="alert-heading"><i class="bi bi-exclamation-circle me-2"></i>No Active Team Assignment</h5>
        <p class="mb-0">You are currently not assigned to coach any esports team. Once a team Owner assigns you as their Head Coach, your team's roster, schedules, and analytics will appear here.</p>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3 bg-dark text-white">
                <div class="d-flex align-items-center">
                    <img src="@(!string.IsNullOrEmpty(Model.AssignedTeam.LogoUrl) ? Model.AssignedTeam.LogoUrl : "/images/default-team-logo.svg")" 
                         alt="@Model.AssignedTeam.Name logo" 
                         class="rounded me-3 border" 
                         style="width:50px;height:50px;object-fit:cover;" 
                         onerror="this.onerror=null;this.src='/images/default-team-logo.svg';" />
                    <div>
                        <h4 class="fw-bold mb-0">@Model.AssignedTeam.Name</h4>
                        <span class="badge bg-primary">@Model.AssignedTeam.Game?.Name</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3 bg-primary text-white">
                <h6 class="text-white-50 text-uppercase">Active Roster Size</h6>
                <h3 class="fw-bold mb-0">@Model.ActiveRoster.Count Players</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3 bg-info text-white">
                <h6 class="text-white-50 text-uppercase">Today's Sessions</h6>
                <h3 class="fw-bold mb-0">@Model.TodaySchedules.Count Events</h3>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill text-primary me-2"></i>Active Team Roster</h5>
                    <a asp-controller="Roster" asp-action="Index" asp-route-teamId="@Model.AssignedTeam.Id" class="btn btn-sm btn-outline-primary">Manage Roster</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Player</th>
                                    <th>Role</th>
                                    <th>Joined</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.ActiveRoster.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No players in active roster yet.</td>
                                    </tr>
                                }
                                @foreach (var m in Model.ActiveRoster)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <img src="@(!string.IsNullOrEmpty(m.User?.ProfilePhotoUrl) ? m.User.ProfilePhotoUrl : "/images/default-user-avatar.svg")" 
                                                 alt="@m.User?.FullName" 
                                                 class="rounded-circle border me-2" 
                                                 style="width:28px;height:28px;object-fit:cover;"
                                                 onerror="this.onerror=null;this.src='/images/default-user-avatar.svg';" />
                                            @m.User?.FullName
                                        </td>
                                        <td><span class="badge bg-info text-dark">@m.GameRole?.RoleName</span></td>
                                        <td>@m.JoinedDate.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">
                                            <a asp-controller="Stats" asp-action="Player" asp-route-id="@m.UserId" class="btn btn-sm btn-outline-secondary">Stats</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-journal-text text-success me-2"></i>Recent Match Performance</h5>
                    <a asp-controller="Record" asp-action="Index" asp-route-teamId="@Model.AssignedTeam.Id" class="btn btn-sm btn-outline-success">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Opponent</th>
                                    <th>Result</th>
                                    <th>Team KDA</th>
                                    <th>Top Performer / MVP</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.RecentMatches.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">No recent match logs found.</td>
                                    </tr>
                                }
                                @foreach (var match in Model.RecentMatches)
                                {
                                    var isWin = string.Equals(match.Result, "Win", StringComparison.OrdinalIgnoreCase);
                                    var mvp = match.Players.FirstOrDefault(p => p.IsMvp) ?? match.Players.OrderByDescending(p => p.Score).FirstOrDefault();
                                    <tr>
                                        <td class="text-nowrap fw-semibold">@match.MatchDate.ToString("yyyy-MM-dd")</td>
                                        <td class="fw-bold">
                                            <span>vs @match.Opponent</span>
                                        </td>
                                        <td>
                                            <span class="badge @(isWin ? "bg-success" : "bg-danger")">@match.Result</span>
                                        </td>
                                        <td class="text-nowrap">
                                            <span class="fw-semibold text-dark">@match.TotalKills</span> /
                                            <span class="text-danger">@match.TotalDeaths</span> /
                                            <span class="text-info">@match.TotalAssists</span>
                                        </td>
                                        <td class="text-nowrap">
                                            @if (mvp != null)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>@mvp.PlayerName</span>
                                                <small class="text-muted ms-1">(@mvp.RoleName)</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Record" asp-action="Index" asp-route-teamId="@Model.AssignedTeam.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i>View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-week text-danger me-2"></i>Today's Sessions</h5>
                    <a asp-controller="Schedule" asp-action="Index" asp-route-teamId="@Model.AssignedTeam.Id" class="btn btn-sm btn-outline-danger">Schedule</a>
                </div>
                <div class="card-body">
                    @if (!Model.TodaySchedules.Any())
                    {
                        <p class="text-muted text-center my-3">No schedule planned for today.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var s in Model.TodaySchedules)
                            {
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between">
                                        <strong class="text-primary">@s.Title</strong>
                                        <span class="badge bg-light text-dark">@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(s.Description))
                                    {
                                        <small class="text-muted d-block mt-1">@s.Description</small>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-light p-3">
                <h6 class="fw-bold mb-2">Quick Navigation</h6>
                <div class="d-grid gap-2">
                    <a asp-controller="Tournament" asp-action="Index" asp-route-teamId="@Model.AssignedTeam.Id" class="btn btn-warning fw-bold text-dark"><i class="bi bi-trophy-fill me-1"></i> Team Tournaments</a>
                    <a asp-controller="Stats" asp-action="Team" asp-route-id="@Model.AssignedTeam.Id" class="btn btn-dark"><i class="bi bi-graph-up me-1"></i> Team Analytics</a>
                </div>
            </div>
        </div>
    </div>
}