<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EsportsManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-uppercase tracking-wider" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-controller me-2 text-warning"></i>EsportsManager
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Owner"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Owner"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                                </li>
                            }
                            else if (User.IsInRole("Coach"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Coach"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                                </li>
                            }
                            else if (User.IsInRole("Player"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Player"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Team" asp-action="Index"><i class="bi bi-shield-shaded me-1"></i> Teams</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Schedule" asp-action="Index"><i class="bi bi-calendar-event me-1"></i> Schedule</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Record" asp-action="Index"><i class="bi bi-journal-text me-1"></i> Match Records</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Tournament" asp-action="Index"><i class="bi bi-trophy-fill me-1 text-warning"></i> Tournaments</a>
                            </li>
                            @if (User.IsInRole("Player"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Stats" asp-action="Player"><i class="bi bi-graph-up me-1"></i> My Stats</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link text-light d-flex align-items-center" asp-controller="Account" asp-action="Profile" title="View & Edit Profile">
                                    <i class="bi bi-person-circle fs-5 me-1 text-info"></i>
                                    <span>Profile</span>
                                </a>
                            </li>
                            <li class="nav-item me-3 text-light d-none d-md-flex align-items-center">
                                <span class="badge bg-secondary me-1">
                                    @(User.IsInRole("Owner") ? "Owner" : User.IsInRole("Coach") ? "Coach" : "Player")
                                </span>
                                <span class="fw-semibold small">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-light me-2" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-warning fw-bold" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 text-center text-muted bg-white mt-auto">
        <div class="container">
            &copy; 2026 - EsportsManager Platform
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
