@model Esports.ViewModels.EditRosterRoleViewModel
@{
    ViewData["Title"] = "Change Role - " + Model.PlayerName;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Change In-Game Role</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-muted">Player: <strong>@Model.PlayerName</strong> | Team: <strong>@Model.TeamName</strong></p>

                <form asp-action="EditRole" asp-route-id="@Model.MembershipId" method="post">
                    <input type="hidden" asp-for="MembershipId" />
                    <input type="hidden" asp-for="TeamId" />
                    <input type="hidden" asp-for="TeamName" />
                    <input type="hidden" asp-for="PlayerName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="GameRoleId" class="form-label fw-semibold"></label>
                        <select asp-for="GameRoleId" asp-items="Model.AvailableRoles" class="form-select"></select>
                        <span asp-validation-for="GameRoleId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" asp-route-teamId="@Model.TeamId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Update Role</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
