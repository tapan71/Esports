@model Esports.ViewModels.AddPlayerToRosterViewModel
@{
    ViewData["Title"] = "Add Player - " + Model.TeamName;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Add Player to @Model.TeamName</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="AddPlayer" method="post">
                    <input type="hidden" asp-for="TeamId" />
                    <input type="hidden" asp-for="TeamName" />
                    <input type="hidden" asp-for="GameName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="UserId" class="form-label fw-semibold"></label>
                        @if (!Model.AvailablePlayers.Any())
                        {
                            <div class="alert alert-info">No available players to recruit.</div>
                        }
                        else
                        {
                            <select asp-for="UserId" asp-items="Model.AvailablePlayers" class="form-select">
                                <option value="">-- Select Registered Player --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="GameRoleId" class="form-label fw-semibold"></label>
                        <select asp-for="GameRoleId" asp-items="Model.AvailableRoles" class="form-select">
                            <option value="">-- Select In-Game Position/Role --</option>
                        </select>
                        <span asp-validation-for="GameRoleId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" asp-route-teamId="@Model.TeamId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary" @(!Model.AvailablePlayers.Any() ? "disabled" : "")><i class="bi bi-person-check-fill me-1"></i>Recruit Player</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
