@model Esports.ViewModels.TeamDetailsViewModel
@{
    ViewData["Title"] = Model.Team.Name + " - Team Details";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div class="d-flex align-items-center me-3 mb-2">
                @if (!string.IsNullOrEmpty(Model.Team.LogoUrl))
                {
                    <img src="@Model.Team.LogoUrl" alt="logo" class="rounded me-3 border" style="width:72px;height:72px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width:72px;height:72px;">
                        <i class="bi bi-shield-fill fs-1"></i>
                    </div>
                }
                <div>
                    <h2 class="fw-bold mb-0">@Model.Team.Name</h2>
                    <p class="text-muted mb-0">Game: <span class="badge bg-dark">@Model.Team.Game?.Name</span> | Created: @Model.Team.CreatedAt.ToString("MMM dd, yyyy")</p>
                </div>
            </div>
            <div class="d-flex gap-2 mb-2">
                @if (Model.CanManage)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Team.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i> Edit Info</a>
                    <a asp-controller="Roster" asp-action="Index" asp-route-teamId="@Model.Team.Id" class="btn btn-primary"><i class="bi bi-people me-1"></i> Manage Roster</a>
                }
                @if (Model.IsOwner)
                {
                    <a asp-action="AssignCoach" asp-route-id="@Model.Team.Id" class="btn btn-outline-warning"><i class="bi bi-person-plus me-1"></i> Assign Coach</a>
                    <a asp-action="Delete" asp-route-id="@Model.Team.Id" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i> Delete</a>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Active Coach Card -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-badge text-success me-2"></i>Head Coach</h5>
            </div>
            <div class="card-body">
                @if (Model.ActiveCoach != null)
                {
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-person-circle fs-1 text-secondary me-3"></i>
                        <div>
                            <h5 class="fw-bold mb-0">@Model.ActiveCoach.User?.FullName</h5>
                            <small class="text-muted">@Model.ActiveCoach.User?.Email</small><br />
                            <small class="text-success">Hired: @Model.ActiveCoach.HiredDate.ToString("MMM dd, yyyy")</small>
                        </div>
                    </div>
                    @if (Model.IsOwner)
                    {
                        <form asp-action="RemoveCoach" method="post">
                            <input type="hidden" name="teamId" value="@Model.Team.Id" />
                            <input type="hidden" name="staffId" value="@Model.ActiveCoach.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100" onclick="return confirm('Remove active coach from team? (History will be preserved)');">Remove Active Coach</button>
                        </form>
                    }
                }
                else
                {
                    <p class="text-muted">No Head Coach currently assigned to this team.</p>
                    @if (Model.IsOwner)
                    {
                        <a asp-action="AssignCoach" asp-route-id="@Model.Team.Id" class="btn btn-sm btn-warning w-100">Hire Coach</a>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Active Roster Card -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill text-primary me-2"></i>Active Players Roster</h5>
                @if (Model.CanManage)
                {
                    <a asp-controller="Roster" asp-action="AddPlayer" asp-route-teamId="@Model.Team.Id" class="btn btn-sm btn-primary"><i class="bi bi-plus me-1"></i>Add Player</a>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Player</th>
                                <th>Role</th>
                                <th>Joined</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ActiveRoster.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No active players on the roster yet.</td>
                                </tr>
                            }
                            @foreach (var p in Model.ActiveRoster)
                            {
                                <tr>
                                    <td class="fw-semibold">@p.User?.FullName</td>
                                    <td><span class="badge bg-info text-dark">@p.GameRole?.RoleName</span></td>
                                    <td>@p.JoinedDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <a asp-controller="Stats" asp-action="Player" asp-route-id="@p.UserId" class="btn btn-sm btn-outline-secondary">Stats</a>
                                        @if (Model.CanManage)
                                        {
                                            <a asp-controller="Roster" asp-action="EditRole" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Role</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- History Section -->
<div class="row g-4 mt-2">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold text-muted"><i class="bi bi-clock-history me-2"></i>Past Roster History</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Player</th>
                                <th>Role</th>
                                <th>Tenure</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PastRoster.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-3 text-muted">No historical roster changes.</td>
                                </tr>
                            }
                            @foreach (var past in Model.PastRoster)
                            {
                                <tr>
                                    <td>@past.User?.FullName</td>
                                    <td><span class="badge bg-light text-dark">@past.GameRole?.RoleName</span></td>
                                    <td>@past.JoinedDate.ToString("yyyy-MM-dd") to @past.LeftDate?.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold text-muted"><i class="bi bi-clock-history me-2"></i>Past Coaching History</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Coach</th>
                                <th>Tenure</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.StaffHistory.Any())
                            {
                                <tr>
                                    <td colspan="2" class="text-center py-3 text-muted">No historical coaching changes.</td>
                                </tr>
                            }
                            @foreach (var staff in Model.StaffHistory)
                            {
                                <tr>
                                    <td>@staff.User?.FullName</td>
                                    <td>@staff.HiredDate.ToString("yyyy-MM-dd") to @staff.RemovedDate?.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
