@model IEnumerable<Esports.Models.Team>
@{
    ViewData["Title"] = "Teams";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Esports Teams</h2>
        <p class="text-muted">Teams and operational management</p>
    </div>
    @if (User.IsInRole("Owner"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Create Team</a>
    }
</div>

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card shadow-sm border-0 text-center py-5">
                <div class="card-body">
                    <i class="bi bi-shield-x display-4 text-muted mb-3"></i>
                    <h5>No Teams Found</h5>
                    <p class="text-muted">You are not associated with any active teams at the moment.</p>
                    @if (User.IsInRole("Owner"))
                    {
                        <a asp-action="Create" class="btn btn-primary">Create Your First Team</a>
                    }
                </div>
            </div>
        </div>
    }
    @foreach (var team in Model)
    {
        var activeCoach = team.TeamStaff?.FirstOrDefault(ts => ts.RemovedDate == null);
        var activeCount = team.TeamMemberships?.Count(tm => tm.LeftDate == null) ?? 0;

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        @if (!string.IsNullOrEmpty(team.LogoUrl))
                        {
                            <img src="@team.LogoUrl" alt="logo" class="rounded me-3 border" style="width:48px;height:48px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width:48px;height:48px;">
                                <i class="bi bi-shield-fill fs-4"></i>
                            </div>
                        }
                        <div>
                            <h5 class="card-title fw-bold mb-0">@team.Name</h5>
                            <span class="badge bg-dark">@team.Game?.Name</span>
                        </div>
                    </div>

                    <div class="mb-3 text-muted small">
                        <div><strong>Owner:</strong> @team.Owner?.FullName</div>
                        <div>
                            <strong>Head Coach:</strong>
                            @if (activeCoach != null)
                            {
                                <span class="text-success"><i class="bi bi-person-badge me-1"></i>@activeCoach.User?.FullName</span>
                            }
                            else
                            {
                                <span class="text-warning">Vacant</span>
                            }
                        </div>
                        <div><strong>Active Roster:</strong> @activeCount Players</div>
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@team.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye me-1"></i>Details</a>
                        <a asp-controller="Roster" asp-action="Index" asp-route-teamId="@team.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-people me-1"></i>Roster</a>
                        <a asp-controller="Stats" asp-action="Team" asp-route-id="@team.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-graph-up me-1"></i>Stats</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
