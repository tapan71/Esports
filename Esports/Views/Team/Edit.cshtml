@model Esports.ViewModels.TeamEditViewModel
@{
    ViewData["Title"] = "Edit Team - " + Model.Name;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Team Profile</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CurrentLogoUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GameId" class="form-label fw-semibold"></label>
                        <select asp-for="GameId" asp-items="Model.AvailableGames" class="form-select"></select>
                        <span asp-validation-for="GameId" class="text-danger small"></span>
                    </div>

                    <div class="card bg-light border-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0"><i class="bi bi-image me-1"></i>Team Logo</h6>
                            @if (Model.CurrentLogoUrl == "/images/default-team-logo.svg")
                            {
                                <span class="badge bg-info text-dark">Default Logo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Custom Logo</span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(Model.CurrentLogoUrl))
                        {
                            <div class="mb-3 d-flex align-items-center bg-white p-2 rounded border">
                                <img src="@Model.CurrentLogoUrl" alt="Current Logo" class="rounded border me-3" style="width:50px;height:50px;object-fit:cover;" />
                                <div>
                                    <span class="small text-muted d-block">Current Logo</span>
                                    <span class="small text-truncate d-inline-block" style="max-width:280px;">@Model.CurrentLogoUrl</span>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="LogoFile" class="form-label fw-semibold"></label>
                            <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="LogoFile" class="text-danger small"></span>
                            <div class="form-text">Upload a new PNG, JPG, or SVG image to replace current logo.</div>
                        </div>

                        <div class="text-center text-muted fw-bold small my-1">- OR -</div>

                        <div>
                            <label asp-for="LogoUrl" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="LogoUrl" class="form-control" id="logoUrlInput" />
                                <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('logoUrlInput').value='/images/default-team-logo.svg';">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Use Default
                                </button>
                            </div>
                            <span asp-validation-for="LogoUrl" class="text-danger small"></span>
                            <div class="form-text">Update with a direct image URL or click "Use Default" to reset to the default logo.</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
