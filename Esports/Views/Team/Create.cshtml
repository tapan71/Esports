@model Esports.ViewModels.TeamCreateViewModel
@{
    ViewData["Title"] = "Create New Team";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-shield-plus me-2"></i>Create New Esports Team</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Cloud9, T1, G2 Esports" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GameId" class="form-label fw-semibold"></label>
                        <select asp-for="GameId" asp-items="Model.AvailableGames" class="form-select">
                            <option value="">-- Select Supported Game --</option>
                        </select>
                        <span asp-validation-for="GameId" class="text-danger small"></span>
                    </div>

                    <div class="card bg-light border-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0"><i class="bi bi-image me-1"></i>Team Logo</h6>
                            <span class="badge bg-secondary">Optional</span>
                        </div>
                        
                        <div class="mb-3 d-flex align-items-center bg-white p-2 rounded border">
                            <img src="/images/default-team-logo.svg" alt="Default Logo" class="rounded border me-3" style="width:48px;height:48px;object-fit:cover;" />
                            <div class="small text-muted">
                                <strong>Default Logo:</strong> If neither file nor URL is provided, the default esports shield logo above will be assigned automatically.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LogoFile" class="form-label fw-semibold"></label>
                            <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="LogoFile" class="text-danger small"></span>
                            <div class="form-text">Upload a custom PNG, JPG, or SVG image file from your device.</div>
                        </div>

                        <div class="text-center text-muted fw-bold small my-1">- OR -</div>

                        <div>
                            <label asp-for="LogoUrl" class="form-label fw-semibold"></label>
                            <input asp-for="LogoUrl" class="form-control" placeholder="https://example.com/logo.png" />
                            <span asp-validation-for="LogoUrl" class="text-danger small"></span>
                            <div class="form-text">Or provide a custom direct online image URL.</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create Team</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
