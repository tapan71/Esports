@model Esports.ViewModels.TeamCreateViewModel
@{
    ViewData["Title"] = "Create New Team";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-shield-plus me-2"></i>Create New Esports Team</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Cloud9, T1, G2 Esports" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GameId" class="form-label fw-semibold"></label>
                        <select asp-for="GameId" asp-items="Model.AvailableGames" class="form-select">
                            <option value="">-- Select Supported Game --</option>
                        </select>
                        <span asp-validation-for="GameId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="LogoUrl" class="form-label fw-semibold"></label>
                        <input asp-for="LogoUrl" class="form-control" placeholder="https://example.com/logo.png" />
                        <span asp-validation-for="LogoUrl" class="text-danger small"></span>
                        <div class="form-text">Direct URL to the team's emblem image.</div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create Team</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
